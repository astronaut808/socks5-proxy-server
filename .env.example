PROXY_USER=someuser
PROXY_PASSWORD=somepass
# PROXY_ACCOUNTS=alice:secret,bob:$2a$12$...
# REQUIRE_AUTH=true

PROXY_PORT=1080
PROXY_LISTEN_IP=0.0.0.0

MAX_CONNECTIONS=100
TIMEOUT=300

ALLOWED_DEST_FQDN=
ALLOWED_IPS=

# Rate limiting (new connections per second, burst = 2x rate)
RATE_LIMIT_PER_SEC=10

# Authentication brute-force protection
MAX_AUTH_FAILURES=5
AUTH_LOCKOUT=300

# TLS settings (SOCKS5 over TLS)
TLS_ENABLED=false
TLS_PORT=10443
TLS_CERT_FILE=/path/to/cert.pem
TLS_KEY_FILE=/path/to/key.pem
TLS_MIN_VERSION=1.2
# TLS_CLIENT_AUTH=false
# TLS_CLIENT_CA_FILE=/path/to/client-ca.pem

# Optional expvar metrics endpoint at /debug/vars
# METRICS_ADDR=127.0.0.1:9090

# Examples:
# ALLOWED_DEST_FQDN=^.*(example\.com|google\.com)$
# ALLOWED_IPS=192.168.1.10,10.0.0.5
